{
  "manifest_version": 3,
  "name": "PageGrab",
  "version": "1.0.0",
  "description": "Capture the entire scrolled page of the current tab as a PNG, in one click.",
  "permissions": ["debugger", "downloads", "activeTab"],
  "action": {
    "default_title": "Capture full page as PNG",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
